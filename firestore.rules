rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (request.auth.token.email == "the323official@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidString(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser() {
      return hasOnlyAllowedFields(['email', 'role', 'createdAt']) &&
             isValidString('email', 3, 100) &&
             request.resource.data.role in ['admin', 'user'] &&
             request.resource.data.createdAt is timestamp;
    }

    function isValidPost() {
      return hasRequiredFields(['title', 'content', 'authorId', 'isPublished', 'createdAt']) &&
             isValidString('title', 1, 200) &&
             isValidString('content', 1, 50000) &&
             request.resource.data.authorId == request.auth.uid &&
             request.resource.data.isPublished is bool &&
             request.resource.data.createdAt is timestamp;
    }

    function isValidTeamMember() {
      return hasRequiredFields(['name', 'role', 'bio', 'order']) &&
             isValidString('name', 1, 100) &&
             isValidString('role', 1, 100) &&
             isValidString('bio', 1, 1000) &&
             request.resource.data.order is number;
    }

    function isValidChatMessage() {
      return hasRequiredFields(['text', 'userId', 'userName', 'isAdmin', 'createdAt']) &&
             isValidString('text', 1, 1000) &&
             request.resource.data.userId == request.auth.uid &&
             isValidString('userName', 1, 100) &&
             request.resource.data.isAdmin is bool &&
             request.resource.data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser() && (request.resource.data.role == 'user' || isAdmin());
      allow update: if isAuthenticated() && isOwner(userId) && isValidUser() && (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isAdmin() && isValidPost();
      allow update: if isAdmin() && isValidPost();
      allow delete: if isAdmin();
    }

    match /teamMembers/{memberId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidTeamMember();
      allow update: if isAdmin() && isValidTeamMember();
      allow delete: if isAdmin();
    }

    match /chatMessages/{messageId} {
      allow read: if isAuthenticated(); // Only logged in users can read chat
      allow create: if isAuthenticated() && isValidChatMessage() && (request.resource.data.isAdmin == isAdmin());
      allow update: if false; // Messages cannot be edited
      allow delete: if isAdmin();
    }
  }
}
